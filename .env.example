# Public origin of the site, no trailing slash. Drives canonical URLs, the
# sitemap and Open Graph tags.
NEXT_PUBLIC_SITE_URL=https://monlooq.com

# MonlooQ API base, server side only (the contact form posts to
# {MONLOOQ_API_URL}/contact from a server action). Include /api/v1.
MONLOOQ_API_URL=https://api.monlooq.com/api/v1
